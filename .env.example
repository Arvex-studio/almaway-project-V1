# MapTiler public browser key: required for the Outdoor basemap.
# Configure in local/cloud environment; never commit a real value.
NEXT_PUBLIC_MAPTILER_KEY=
# Optional foundation; demo UI does not read these values.
# Use only the AlmaWay project URL or the isolated local stack documented in docs/backend-foundation.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; never expose through NEXT_PUBLIC_ variables.
AI_API_KEY=

# Session refresh is opt-in and LOCAL ONLY during Phase 2B-2.
# Keep false until using the isolated local stack. Hosted Auth remains gated.
ALMAWAY_LOCAL_AUTH_ENABLED=false
